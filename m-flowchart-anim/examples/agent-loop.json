{
  "kicker": "FIG 01 // AGENT WORKFLOW",
  "title": "让 Claude Code 自己修 Bug",
  "subtitle": "从报错到合并，一个 Agent 的完整闭环",
  "summary": "Agent 先复现问题再改代码；测试不过就带着失败信息回到修改，最多重试三次，通过后才交给人审。",
  "footer": "claude --model opus",
  "nodes": [
    {"id": "issue", "label": "收到报错", "desc": "用户贴来一段报错日志", "tag": "input"},
    {"id": "repro", "label": "复现问题", "desc": "写一个会失败的测试", "tag": "agent"},
    {"id": "read", "label": "读相关代码", "desc": "只打开报错涉及的文件", "tag": "agent"},
    {"id": "fix", "label": "修改代码", "desc": "改动尽量小", "tag": "agent"},
    {"id": "test", "label": "跑测试", "desc": "新测试 + 原有测试", "tag": "check"},
    {"id": "review", "label": "人工审核", "desc": "看 diff，决定合并", "tag": "human"},
    {"id": "merge", "label": "合并上线", "desc": "关闭 issue", "tag": "output"}
  ],
  "edges": [
    {"from": "issue", "to": "repro"},
    {"from": "issue", "to": "read"},
    {"from": "repro", "to": "fix"},
    {"from": "read", "to": "fix"},
    {"from": "fix", "to": "test"},
    {"from": "test", "to": "fix", "label": "失败 · 重试"},
    {"from": "test", "to": "review", "label": "通过"},
    {"from": "review", "to": "merge"}
  ],
  "steps": [
    {"nodes": ["issue"], "caption": "一切从一段报错开始，Agent 不急着改代码。"},
    {"nodes": ["repro", "read"], "title": "复现 + 读代码", "caption": "同时做两件事：写一个能稳定失败的测试，并只读和报错有关的文件。"},
    {"nodes": ["fix"], "caption": "根据失败的测试做最小改动，不顺手重构。"},
    {"nodes": ["test"], "caption": "跑全部测试；失败就带着错误信息回去改，最多三次。"},
    {"nodes": ["review"], "caption": "测试通过后停下来，把 diff 交给人看。"},
    {"nodes": ["merge"], "caption": "人点头才合并，Agent 关闭 issue 并写一句总结。"}
